<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0E14">

    <!-- Layer belakang: hero image + overlay. Sengaja TIDAK clickable supaya
         tidak pernah mencuri sentuhan dari tombol di atasnya. -->
    <ImageView
        android:id="@+id/hero_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:contentDescription="@null"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@android:drawable/sym_def_app_icon" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_overlay"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no" />

    <!-- Satu-satunya layer interaktif penuh: ScrollView. Semua tombol ada di
         dalamnya, jadi tidak ada overlay yang menghalangi klik dan konten tetap
         bisa dijangkau di layar pendek. -->
    <ScrollView
        android:id="@+id/content_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!-- ===== Top bar: kartu koleksi + aksi bulat ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Kartu koleksi -->
                        <LinearLayout
                            android:id="@+id/card_collection"
                            android:layout_width="92dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/card_clickable"
                            android:clickable="true"
                            android:contentDescription="@string/card_collection"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@android:drawable/ic_menu_sort_by_size" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/card_collection"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Kartu target Braid (aktif) -->
                        <LinearLayout
                            android:id="@+id/card_braid"
                            android:layout_width="92dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="10dp"
                            android:background="@drawable/card_selected"
                            android:clickable="true"
                            android:contentDescription="@string/card_braid"
                            android:focusable="true"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <ImageView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:src="@android:drawable/sym_def_app_icon" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/card_braid"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/card_braid_sub"
                                android:textColor="#4DA3FF"
                                android:textSize="9sp" />
                        </LinearLayout>

                    </LinearLayout>
                </HorizontalScrollView>

                <ImageButton
                    android:id="@+id/btn_info"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/round_clickable"
                    android:contentDescription="@string/btn_info_desc"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_info_details" />

                <ImageButton
                    android:id="@+id/btn_settings"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/round_clickable"
                    android:contentDescription="@string/btn_settings_desc"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_preferences" />

                <ImageButton
                    android:id="@+id/btn_refresh"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/round_clickable"
                    android:contentDescription="@string/btn_refresh_desc"
                    android:padding="11dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_menu_refresh" />

            </LinearLayout>

            <!-- Fleksibel: mendorong konten hero ke bawah pada layar tinggi -->
            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- ===== Hero info ===== -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.04"
                android:text="@string/hero_title"
                android:textColor="#FFFFFF"
                android:textSize="34sp"
                android:textStyle="bold" />

            <View
                android:layout_width="64dp"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/accent_bar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/hero_metadata"
                android:textColor="#8FA3BF"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/hero_subtitle"
                android:textColor="#5C6B80"
                android:textSize="11sp" />

            <!-- ===== Tombol aksi ===== -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pill_primary"
                    android:backgroundTint="@null"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="48dp"
                    android:minWidth="132dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="@string/btn_play"
                    android:textAllCaps="false"
                    android:textColor="#000000"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_import"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/pill_secondary"
                    android:backgroundTint="@null"
                    android:fontFamily="sans-serif-medium"
                    android:minHeight="48dp"
                    android:minWidth="132dp"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:text="@string/btn_import"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

            </LinearLayout>

            <!-- ===== Kartu hasil import ===== -->
            <LinearLayout
                android:id="@+id/import_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="14dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/section_import"
                        android:textColor="#4DA3FF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/import_progress"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#8FA3BF"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/import_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:lineSpacingExtra="2dp"
                    android:textColor="#E6EDF7"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />

            </LinearLayout>

            <!-- ===== Petunjuk gamepad ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="end"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/hint_play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/hint_play_desc"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/controller_icon_bg"
                        android:gravity="center"
                        android:text="A"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/hint_play"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/hint_back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/hint_back_desc"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="@drawable/controller_icon_bg"
                        android:gravity="center"
                        android:text="B"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/hint_back"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- ===== Status footer ===== -->
            <TextView
                android:id="@+id/status_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:padding="10dp"
                android:text="@string/state_not_ready"
                android:textColor="#8FA3BF"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
